#!/bin/bash

#SBATCH -p rapids
#SBATCH -n 1
#SBATCH -N 1
#SBATCH -t 08:00:00
#SBATCH -J generateMissingAlignments
#SBATCH -o /share/ceph/wym219group/shared/erroutfiles/seaverErrors/filtonlyfastpylog2.out
#SBATCH --open-mode=append
#SBATCH --mail-type=ALL
#SBATCH --mail-user=aws519@lehigh.edu

python -m venv biopython_env
source biopython_env/bin/activate
pip install biopython

GENE_FILE="/share/ceph/wym219group/shared/projects/seaverProjects/RunRERBinaryMT/Output/CategoricalInsVertivoreTree/Hyphy/MissingAlignmentList.txt"

if [[ ! -f "$GENE_FILE" ]]; then
    echo "Error: Gene file not found at: $GENE_FILE"
    exit 1
fi

while IFS= read -r line; do
    gene=$(echo "$line" | awk '{print $1}')
    echo "Processing: $gene"
    
    # Find the gene in the list file and get its path
    gene_path=$(grep -F -- "$gene" "/share/ceph/wym219group/shared/projects/MammalDiet/Zoonomia/Summary_Phase3Alns/ListAllFasWithPath.txt" | head -n1)
    
    if [[ -n "$gene_path" ]]; then
        python filterAlignments.py "$gene_path"
    else
        echo "Warning: Path not found for gene: $gene"
    fi
done < "$GENE_FILE"
