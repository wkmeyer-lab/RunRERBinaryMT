#!/bin/bash

#SBATCH -p rapids
#SBATCH -n 1
#SBATCH -N 1
#SBATCH -t 08:00:00
#SBATCH -J generateMissingAlignments
#SBATCH -o /share/ceph/wym219group/shared/erroutfiles/seaverErrors/filtonlyfastpylog2.out
#SBATCH --open-mode=append
#SBATCH --mail-type=ALL
#SBATCH --mail-user=aws519@lehigh.edu

python -m venv biopython_env
source biopython_env/bin/activate
pip install biopython

GENE_FILE="/share/ceph/wym219group/shared/projects/seaverProjects/RunRERBinaryMT/Output/CategoricalInsVertivoreTree/Hyphy/MissingAlignmentList.txt"
LIST_FILE="/share/ceph/wym219group/shared/projects/MammalDiet/Zoonomia/Summary_Phase3Alns/ListAllFasWithPath.txt"
REF_DIR="/share/ceph/wym219group/shared/data/filtered_translated_alignments"

if [[ ! -f "$GENE_FILE" ]]; then
    echo "Error: Gene file not found at: $GENE_FILE"
    exit 1
fi

while IFS= read -r line; do
    gene=$(echo "$line" | awk '{print $1}')
    echo "Processing: $gene"

    #look for a file that matches the pattern *.GENE_NAME.* in translated alignments
    ref_match=$(find "$REF_DIR" -maxdepth 1 -name "*.$gene.*" | head -n1)

    if [[ -z "$ref_match" ]]; then
        echo "Warning: No reference transcript found for gene $gene in $REF_DIR. Skipping."
        continue
    fi

    #extract the transcript ID
    target_transcript=$(basename "$ref_match" | cut -d'.' -f1)

    echo "   -> Matched Transcript ID: $target_transcript"

    #match transcript ID for filtering
    gene_path=$(grep -F "$target_transcript" "$LIST_FILE" | head -n1)

    if [[ -n "$gene_path" ]]; then
        #check if file is empty before running python script
        if [[ -s "$gene_path" ]]; then
             python filterAlignments.py "$gene_path"
        else
             echo "   -> Skipping: Input alignment file is empty (0 bytes)."
        fi
    else
        echo "Warning: Path not found in ListAllFasWithPath.txt for transcript: $target_transcript"
    fi
done < "$GENE_FILE"
