#!/bin/bash

#SBATCH -p rapids
#SBATCH -n 1
#SBATCH -N 1
#SBATCH -t 24:00:00
#SBATCH -J hyphyCluster
#SBATCH -o /share/ceph/wym219group/shared/erroutfiles/seaverErrors/%j.%N.out
#SBATCH --open-mode=append
#SBATCH --mail-type=TIME_LIMIT
#SBATCH --mail-user=aws519@lehigh.edu

# --- New Error Handling ---
# This makes the script exit immediately if any command fails
set -e

# Define a variable to track what the script is doing
CURRENT_STEP="Initialization"

# Define the path to the single, master error log for all genes
# (You can change this path if you want)
MASTER_ERROR_LOG="/share/ceph/wym219group/shared/projects/seaverData/RunRERBinaryMT/Output/CategoricalInsVertivoreTree/Hyphy/MASTER_JOB_FAILURE_LOG.txt"

# This function will be called when the script exits, for any reason
error_trap() {
  # Get the exit code of the last command
  local exit_code=$?
  
  # Check if the exit code is NOT 0 (which means an error occurred)
  if [ $exit_code -ne 0 ]; then
    echo "Job for $GENENAME failed at step: $CURRENT_STEP (Exit code: $exit_code)"
    
    # Use flock to prevent multiple jobs from writing to the log at the exact same time
    # (This is safer for a central log file)
    (
      flock 200
      echo "$GENENAME - ERROR during $CURRENT_STEP" >> "$MASTER_ERROR_LOG"
    ) 200>"$MASTER_ERROR_LOG.lock"
    
  fi
}

# Set the trap: Call the 'error_trap' function when the script EXITS
trap error_trap EXIT

#Usage:
#Cd to the project's main directory
#sbatch runRERmt.slr <Project name> <Hyphy Tool Name> <File Prefix> <Target Gene> <ForegroundPathValue> <BinarizeValue>
module load r
module load hyphy

ALIGNMENTPATH="/share/ceph/wym219group/shared/data/filtered_alignments"
FILTEREDPATH="/share/ceph/wym219group/shared/data/fixed_filtered_translated_alignments"
echo AlignmentPath: $ALIGNMENTPATH

PROJECTNAME=$1 #This is the first input after the submission script name
TOOLNAME=$2
FILEPREFIX=$3
GENENAME=$4
FOREGROUNDPATHVALUE=$5
BINARIZEVALUE=$6
BACKGROUNDVALUE=$7

echo ProjectName: $PROJECTNAME
echo Hyphy tool: $TOOLNAME
echo FilePrefix: $FILEPREFIX
echo GeneName: $GENENAME
echo ForegroundValue: $FOREGROUNDPATHVALUE
echo BinarizeValue: $BINARIZEVALUE


#Find the fasta alignment file for that gene
CURRENT_STEP="Finding Fasta"
cd $ALIGNMENTPATH

GENENAMESEARCH="${GENENAME}."
count=$(find | grep $GENENAMESEARCH |wc -l)
echo count: $count
if [ $count -gt 1 ]; then
        cd $FILTEREDPATH
        FASTAFILEBASE=$(find | grep $GENENAMESEARCH | head -n 1)
        echo FASTAFILEBASE: $FASTAFILEBASE
        FASTAFILEBASE="${FASTAFILEBASE:2:-11}"
        FASTAFILE="${FASTAFILEBASE}.filt.fa"
        #code
else
        FASTAFILE=$(find | grep $GENENAME)
        FASTAFILE="${FASTAFILE:2}"
fi
echo "Fasta file is:"
echo $FASTAFILE

FASTAFILEPATH="${ALIGNMENTPATH}/${FASTAFILE}"
echo "Fasta file path is:"
echo $FASTAFILEPATH

if [ -f $FASTAFILEPATH  ]; then
        echo "File exists."
else
        if [ $count -gt 1 ]; then
                echo "Filtered file does not match  base file, using first base file."
                cd $ALIGNMENTPATH
                FASTAFILE=$(find | grep $GENENAME |head -n 1)
                FASTAFILE="${FASTAFILE:2}"
                echo "Fasta file is:"
                echo $FASTAFILE
                
                FASTAFILEPATH="${ALIGNMENTPATH}/${FASTAFILE}"
                echo "Fasta file path is:"
                echo $FASTAFILEPATH

        else
                CURRENT_STEP="Missing Fasta File" # Set step before exiting
                echo "Fasta File does not exist. Adding current gene of list of missing file genes."
                cd /share/ceph/wym219group/shared/projects/seaverData/$PROJECTNAME/Output/$FILEPREFIX/Hyphy
                missingAlignmentNotificationFilename="missing-Alignment-${GENENAME}.txt"
                touch $missingAlignmentNotificationFilename
                echo "This was generated by a script with the arguments:" >> $missingAlignmentNotificationFilename
                echo ProjectName: $PROJECTNAME >> $missingAlignmentNotificationFilename
            _   echo Hyphy tool: $TOOLNAME >> $missingAlignmentNotificationFilename
                echo FilePrefix: $FILEPREFIX >> $missingAlignmentNotificationFilename
                echo GeneName: $GENENAME >> $missingAlignmentNotificationFilename
                echo ForegroundValue: $FOREGROUNDPATHVALUE >> $missingAlignmentNotificationFilename


                touch "MissingAlignmentList.txt"
                echo "${GENENAME} count:${count}" >> "MissingAlignmentList.txt"

                exit 1 # Changed from 12345. This will trigger the error_trap.
        fi

fi


echo "#########################################################################"

#Generate the hyphy input file
CURRENT_STEP="Generating HyPhy Input (hyphyFileMake.R)"
cd /share/ceph/wym219group/shared/projects/seaverData/$PROJECTNAME

module load r
HYPHYINPUTFILENAME="${FILEPREFIX}${GENENAME}HyphyInputFile.fna"
if [ -f $HYPHYINPUTFILENAME ] ; then
        echo "Input File exists"
else
        echo "Generating Input file"
        R --no-save --args g=$GENENAME a=$FASTAFILEPATH r=$FILEPREFIX f=$FOREGROUNDPATHVALUE b=$BINARIZEVALUE </share/ceph/wym219group/shared/projects/seaverData/$PROJECTNAME/Src/Reu/hyphyFileMake.R
fi

echo "#######################################################################"


# Run hyphy itself
CURRENT_STEP="Running HyPhy ($TOOLNAME)"
cd ./Output/$FILEPREFIX/Hyphy
OUTPUTFILENAME="${FILEPREFIX}-Hyphy-${TOOLNAME}-${GENENAME}-Foreground_${FOREGROUNDPATHVALUE}.json"

module load hyphy

if [[ "$TOOLNAME" == "relax" ]] ; then
  # Check if binarization is set to True (case-sensitive)
  if [[ "$BINARIZEVALUE" == "T" || "$BINARIZEVALUE" == "TRUE" ]] ; then
    hyphy $TOOLNAME --alignment $HYPHYINPUTFILENAME --test $FOREGROUNDPATHVALUE --reference Background --output $OUTPUTFILENAME
  else
    hyphy $TOOLNAME --alignment $HYPHYINPUTFILENAME --test $FOREGROUNDPATHVALUE --reference $BACKGROUNDVALUE --output $OUTPUTFILENAME
  fi
else
  # Runs for any tool other than "relax"
  hyphy $TOOLNAME --alignment $HYPHYINPUTFILENAME --branches $FOREGROUNDPATHVALUE --output $OUTPUTFILENAME
fi

CURRENT_STEP="Extracting P-values (ExtractHyphyPvalues.R)"
cd /share/ceph/wym219group/shared/projects/seaverData/$PROJECTNAME
R --no-save --args g=$GENENAME f=$FOREGROUNDPATHVALUE r=$FILEPREFIX t=$TOOLNAME </share/ceph/wym219group/shared/projects/seaverData/$PROJECTNAME/Src/Reu/ExtractHyphyPvalues.R

# If the script reaches here, it was successful.
# The trap will still run, but $? will be 0, so nothing will be logged.
CURRENT_STEP="Success"
