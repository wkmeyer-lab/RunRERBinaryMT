#!/bin/bash

#SBATCH -p rapids
#SBATCH -n 1
#SBATCH -N 1
#SBATCH -t 10
#SBATCH -J hyphyCluster
#SBATCH -o /share/ceph/wym219group/shared/erroutfiles/michaelTene/%j.%N.out
#SBATCH --open-mode=append
#SBATCH --mail-type=ALL
#SBATCH --mail-user=mit221@lehigh.edu

#The lines above are slurm inputs. Anything else starting with a # is a comment.

#Usage:
#Cd to the project's main directory
#sbatch runRERmt.slr <Project name> <Hyphy Tool Name> <File Prefix> <Target Gene> <ForegroundPathValue> <Argument 1> <Argument 2> <etc.>


ALIGNMENTPATH="/share/ceph/wym219group/shared/data/filtered_alignments"
FILTEREDPATH="/share/ceph/wym219group/shared/data/fixed_filtered_translated_alignments"
echo AlignmentPath: $ALIGNMENTPATH

PROJECTNAME=$1 #This is the first input after the submission script name
TOOLNAME=$2
FILEPREFIX=$3
GENENAME=$4
FOREGROUNDPATHVALUE=$5

echo ProjectName: $PROJECTNAME
echo Hyphy tool: $TOOLNAME
echo FilePrefix: $FILEPREFIX
echo GeneName: $GENENAME
echo ForegroundValue: $FOREGROUNDPATHVALUE

#Collect additional Arguments
ARG1=$6
ARG2=$7
ARG3=$8
ARG4=$9

#Find the fasta alignment file for that gene
cd $ALIGNMENTPATH

count=$(find | grep $GENENAME |wc -l)
echo count: $count
if [ $count -gt 1 ]; then
        cd $FILTEREDPATH
        FASTAFILEBASE=$(find | grep $GENENAME)
        echo FASTAFILEBASE: $FASTAFILEBASE
        FASTAFILEBASE="${FASTAFILEBASE:2:-11}"
        FASTAFILE="${FASTAFILEBASE}.filt.fa"
        #code
else
        FASTAFILE=$(find | grep $GENENAME)
        FASTAFILE="${FASTAFILE:2}"
fi
echo "Fasta file is:"
echo $FASTAFILE

FASTAFILEPATH="${ALIGNMENTPATH}/${FASTAFILE}"
echo "Fasta file path is:"
echo $FASTAFILEPATH

#Generate the hyphy input file
cd /share/ceph/hawk/wym219_123121/shared/mit221/projects/$PROJECTNAME

module load r
R --no-save --args g=$GENENAME a=$FASTAFILEPATH r=$FILEPREFIX $ARG1 $ARG2 $ARG3 $ARG4 </share/ceph/hawk/wym219_123121/shared/mit221/projects/$PROJECTNAME/Src/Reu/hyphyFileMake.R
HYPHYINPUTFILENAME="${FILEPREFIX}${GENENAME}HyphyInputFile.fna"

# Run hyphy itself
cd ./Output/$FILEPREFIX/Hyphy
OUTPUTFILENAME="${FILEPREFIX}-Hyphy-${TOOLNAME}-${GENENAME}-Foreground_${FOREGROUNDPATHVALUE}.json"

module load hyphy
hyphy $TOOLNAME $HYPHYINPUTFILENAME --branches $FOREGROUNDPATHVALUE --output $OUTPUTFILENAME
